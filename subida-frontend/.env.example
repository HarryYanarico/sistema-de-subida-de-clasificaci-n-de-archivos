# ==============================================================================
# Variables de Entorno - Ejemplo / Plantilla
# ==============================================================================
# Copia este archivo como .env.development o .env.production según corresponda.

# URL base del backend Django
VITE_API_URL=http://localhost:8000

# Ruta del endpoint GraphQL (relativa o absoluta)
VITE_GRAPHQL_PATH=/graphql/

# Prefijo para la API REST (uploads, thumbnails, etc.)
VITE_API_PREFIX=/api

# Título institucional de la aplicación
VITE_APP_TITLE="Sistema de Digitalización de Archivos"
