# Django
DJANGO_SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True

# PostgreSQL
# IMPORTANTE: la base de datos NO corre en Docker. Esta instalada de forma
# nativa en el host. Docker solo levanta minio, backend y frontend.
# El backend corre DENTRO de un contenedor, por eso necesita host.docker.internal
# para alcanzar la base del host. Si ejecutas Django fuera de Docker, usa localhost.
POSTGRES_DB=digitalizacion
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar-esta-contrasena
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=digitalizacion
MINIO_USE_SSL=False

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Sincronizacion periodica desde Drive (servicio scheduler)
# Minutos entre sincronizaciones. Se lee al arrancar el servicio,
# cambiarlo exige: docker compose up -d --force-recreate scheduler
SYNC_INTERVAL_MINUTOS=240

# Credencial de la cuenta de servicio de Google, usada cuando un OrigenArchivos
# deja credencial_ref vacio. Debe ser el JSON completo de la clave.
# Alternativa preferible: poner la RUTA del JSON en credencial_ref desde el admin.
# DRIVE_CREDENTIALS_PATH=/run/secrets/drive.json

# Gemini AI (Google AI Studio)
GEMINI_API_KEY=your-api-key-here
